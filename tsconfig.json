{
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "esnext"],
    "module": "ES2020",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "es2020",
    "moduleResolution": "bundler"
  },
  "exclude": ["node_modules"],
  "include": ["apps/**/*", "libs/**/*"]
}
